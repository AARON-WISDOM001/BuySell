# --- Supabase -------------------------------------------------------------
# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxx

# Optional legacy anon key also works here. The secret/service-role key is NOT
# used by the application: narrow SECURITY DEFINER functions handle privileged
# writes, so no bypass key is needed server-side.

# --- Google OAuth ---------------------------------------------------------
# Configured in Supabase -> Authentication -> Providers -> Google.
# Add this exact URL to Google's authorised redirect URIs:
#   <NEXT_PUBLIC_SITE_URL>/auth/callback

# --- Mailgun --------------------------------------------------------------
MAILGUN_API_KEY=key-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MAILGUN_DOMAIN=mg.yourdomain.com
MAILGUN_FROM_EMAIL=orders@mg.yourdomain.com

# --- Site -----------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app
NEXT_PUBLIC_STORE_NAME=BuySell
